# Every Makefile target writes its outputs to build/ (libraries, build/sim/,
# build/formal/, build/cov/; see the Makefile header). The entries below build/
# are a fallback for a Questa tool started by hand from the repo root.
build/

# QuestaSim (vlib / vlog / vopt / vsim) outputs
questa_work/
formal_work/
work/
*_opt
transcript
*.wlf
modelsim.ini
*.ses
tr_db.log
vsim.dbg
vish_stacktrace.vstf

# Questa Formal (qverify / PropCheck) outputs
.qverify/
propcheck.db/
*.rpt
formal_report*.txt
!formal/reference/formal_report*.txt
qverify_cmds.tcl
qverify_ui_cmds.tcl

# Coverage (vcover)
*.ucdb

# Questa Visualizer / startup scratch (empty files named etch<pid>)
*.qwdb
qwave.db
.visualizer/
visualizer.log
sysinfo.log
etch[0-9]*

# Waves and logs
*.vcd
*.fst
*.log

# Local open-source lint / smoke (verilator, iverilog)
obj_dir/
*.vvp

# Python / editor / OS
__pycache__/
*.pyc
.vscode/
.DS_Store
*.swp
*.swo
